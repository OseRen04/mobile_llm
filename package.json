{
  "name": "local-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build:web && npm run build:extension",
    "build:web": "vite build --config vite.config.ts && node scripts/finalize-build.mjs web",
    "build:test": "VITE_MODEL_TEST=1 vite build --config vite.config.ts && node scripts/finalize-build.mjs web",
    "build:extension": "vite build --config vite.extension.config.ts && node scripts/finalize-build.mjs extension",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:models": "playwright test --config playwright.models.config.ts",
    "verify:models": "python3 scripts/verify-models.py",
    "predev": "node scripts/prepare-runtime.mjs",
    "test:extension": "playwright test --config playwright.extension.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@playwright/test": "1.65.1",
    "@types/chrome": "0.0.326",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.1",
    "eslint": "9.28.0",
    "globals": "16.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "jsdom": "26.1.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "tinypool": "2.1.2"
  }
}
